#!name=IP 质检
#!desc=双源 IP 质检（Net.Coffee + IPFinal），请先在参数内选择策略组。
#!category=网络检测
#!arguments=Proxy:DIRECT,MarkIP:false
#!arguments-desc=Proxy: 选择策略组,默认DIRECT | MarkIP: IP 打码(true/false),默认 false

[Rule]
# 确保检测请求走选定的代理策略
DOMAIN-SUFFIX,ip.net.coffee,{{{Proxy}}}
DOMAIN-SUFFIX,ipfinal.com,{{{Proxy}}}

[Panel]
IPCheck = script-name=IPCheck, title=IP 质检, content=刷新中…, style=info, update-interval=300

[Script]
IPCheck = type=generic, timeout=20, argument={{{MarkIP}}}, script-path=https://raw.githubusercontent.com/Likhixang/Egerny/main/js/IPCheck.js
