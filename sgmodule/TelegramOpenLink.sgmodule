#!name=TeleOpenLink
#!desc=Telegram 外部链接跳转至指定客户端
#!author=Li Khixang
#!homepage=https://github.com/Likhixang
#!arguments=Client:sg
#!arguments-desc=Client: 目标客户端 URL scheme（sg / turrit / telegram 等）

[URL Rewrite]
# 用户 / 频道 / 群组 / Bot（含 start 参数）
(https:\/\/)?(t\.me|telegram\.me|telegram\.dog)\/([A-Za-z0-9_]+)(\?.*)?$ {{{Client}}}://resolve?domain=$3 302

# 指定消息
(https:\/\/)?(t\.me|telegram\.me|telegram\.dog)\/([A-Za-z0-9_]+)\/([0-9]+)$ {{{Client}}}://resolve?domain=$3&post=$4 302

# 邀请链接（joinchat / +）
(https:\/\/)?(t\.me|telegram\.me|telegram\.dog)\/(joinchat\/|\+)([A-Za-z0-9_-]+)$ {{{Client}}}://join?invite=$4 302

# 私有频道消息
(https:\/\/)?(t\.me|telegram\.me|telegram\.dog)\/c\/([0-9]+)\/([0-9]+)$ {{{Client}}}://privatepost?channel=$3&post=$4 302

# 预览页
(https:\/\/)?telesco\.pe\/(.+)$ {{{Client}}}://resolve?domain=$2 302

[MITM]
hostname = %APPEND% t.me, telegram.me, telegram.dog, telesco.pe
