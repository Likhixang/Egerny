#!name=流媒体解锁检测
#!desc=检测当前节点的流媒体解锁情况，支持 Netflix / Disney+ / YouTube Premium 等 18 个服务。
#!category=流媒体

[Panel]
stream-check = script-name=stream-check, title=流媒体解锁, content=检测中…, update-interval=3600

[Script]
stream-check = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/Likhixang/Egerny/main/js/StreamCheck.js
