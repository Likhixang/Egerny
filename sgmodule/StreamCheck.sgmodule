#!name=流媒体解锁检测
#!desc=检测当前节点的流媒体解锁情况，支持 Netflix / Disney+ / YouTube Premium 等服务。
#!category=流媒体
#!arguments=UPDATE_INTERVAL:3600
#!arguments-desc=UPDATE_INTERVAL: 面板刷新间隔（秒），默认 3600

[Panel]
stream-check = script-name=stream-check, title=流媒体解锁, content=检测中…, update-interval={{{UPDATE_INTERVAL}}}

[Script]
stream-check = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/Likhixang/Egerny/main/js/StreamCheck.js
